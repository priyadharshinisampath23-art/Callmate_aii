
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090817">
<title>CallMate AI</title>

<link rel="manifest" id="manifest">

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Arial,sans-serif;
  background:#090817;
  color:white;
  min-height:100vh;
  display:flex;
  justify-content:center;
}
button{font:inherit;border:0;cursor:pointer;color:white}
.app{
  width:100%;max-width:430px;min-height:100vh;
  background:linear-gradient(160deg,#17112f,#090817 65%);
  position:relative;overflow:hidden;
  padding:25px 22px;
}
.page{display:none;min-height:calc(100vh - 50px)}
.page.active{display:flex;flex-direction:column}
.logo{
  width:76px;height:76px;border-radius:25px;
  background:linear-gradient(135deg,#a855f7,#5b21b6);
  display:grid;place-items:center;
  margin:35px auto 18px;
  box-shadow:0 0 35px #9333ea55;
}
.logo svg{width:45px;height:45px}
.brand{text-align:center;font-size:29px;font-weight:800}
.brand span{color:#c084fc}
.subtitle{text-align:center;color:#aaa2bd;margin-top:9px;font-size:14px}
.section-title{font-size:17px;margin:34px 0 14px}
.topics{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.topic{
  background:#ffffff0b;border:1px solid #ffffff18;
  padding:17px 12px;border-radius:15px;text-align:left;
  color:#eee;font-size:14px;min-height:65px;
}
.topic.selected{border:1px solid #c084fc;background:#8b5cf633}
.topic small{display:block;color:#aaa;margin-top:6px}
input,select{
  width:100%;padding:15px;border-radius:12px;
  background:#ffffff0d;border:1px solid #ffffff22;
  color:white;outline:none;margin-top:12px;
}
select option{background:#17112f}
.primary{
  width:100%;padding:17px;border-radius:30px;
  background:linear-gradient(100deg,#9333ea,#6d28d9);
  font-weight:bold;margin-top:24px;
  box-shadow:0 8px 25px #7e22ce44;
}
.note{text-align:center;color:#8e879e;font-size:12px;margin-top:15px;line-height:1.5}
.topbar{display:flex;justify-content:space-between;align-items:center}
.topbar strong{font-size:20px}
.topbar span{color:#c084fc}
.back{background:#ffffff12;padding:10px 14px;border-radius:20px}
.call-page{align-items:center;text-align:center}
.avatar{
  width:125px;height:125px;border-radius:50%;
  background:linear-gradient(135deg,#9333ea,#312e81);
  display:grid;place-items:center;margin:75px auto 25px;
  box-shadow:0 0 45px #9333ea55;
}
.avatar svg{width:65px;height:65px}
.caller{font-size:27px;font-weight:bold}
.topic-label{color:#c4b5fd;margin-top:9px}
.call-status{color:#aaa;margin-top:13px;font-size:14px}
.timer{font-size:17px;letter-spacing:2px;margin-top:13px;color:#e9d5ff}
.incoming-actions{display:flex;justify-content:center;gap:65px;margin-top:auto;padding-bottom:35px}
.call-action{display:flex;flex-direction:column;align-items:center;gap:10px;font-size:12px;color:#ccc}
.round{
  width:65px;height:65px;border-radius:50%;
  display:grid;place-items:center;font-size:25px;
}
.green{background:#16a34a}
.red{background:#dc2626}
.controls{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:25px 12px;margin-top:45px;width:100%;
}
.control{
  display:flex;flex-direction:column;align-items:center;
  gap:10px;color:#c9c4d4;font-size:12px;
}
.control .round{background:#ffffff16;width:58px;height:58px;font-size:21px}
.control.active .round{background:#9333ea}
.end-button{margin-top:auto;margin-bottom:20px}
.end-button .round{width:70px;height:70px;margin:auto}
.call-page .avatar.connected{margin-top:45px}
.message{
  background:#ffffff0d;border:1px solid #ffffff15;
  border-radius:14px;padding:13px;margin-top:20px;
  width:100%;min-height:55px;color:#e9d5ff;
  font-size:13px;line-height:1.5;
}
.keypad{
  display:none;grid-template-columns:repeat(3,1fr);
  gap:10px;width:100%;margin-top:20px;
}
.keypad button{background:#ffffff13;border-radius:50%;height:55px;font-size:20px}
.end-icon{
  width:105px;height:105px;border-radius:50%;
  background:#ffffff12;display:grid;place-items:center;
  font-size:45px;margin:100px auto 25px;
}
.summary{text-align:center;color:#aaa;margin-top:12px}
.duration{font-size:27px;margin-top:15px;color:#e9d5ff}
.secondary{
  background:#ffffff12;border:1px solid #ffffff20;
  padding:15px;border-radius:30px;width:100%;margin-top:12px;
}
.footer{text-align:center;color:#655d78;font-size:11px;margin-top:20px}
</style>
</head>

<body>
<div class="app">

<!-- HOME PAGE -->
<section id="home" class="page active">
  <div class="logo">
    <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8">
      <path d="M5 4h3l2 5-2 2c1.2 2.5 2.5 3.8 5 5l2-2 5 2v3c0 1-1 2-3 2C9 20 4 15 3 7c0-2 1-3 2-3z"/>
      <path d="M15 4c2.5.5 4 2 4.5 4.5M15 8c.8.2 1.3.7 1.5 1.5"/>
    </svg>
  </div>
  <div class="brand">CallMate <span>AI</span></div>
  <p class="subtitle">Your friendly English speaking partner</p>

  <h3 class="section-title">Choose your conversation topic</h3>
  <div class="topics">
    <button class="topic selected" onclick="chooseTopic(this,'Daily Conversation')">☀️ Daily Conversation<small>Everyday English</small></button>
    <button class="topic" onclick="chooseTopic(this,'Job Interview')">💼 Job Interview<small>Practice interviews</small></button>
    <button class="topic" onclick="chooseTopic(this,'Travel')">✈️ Travel<small>Travel conversations</small></button>
    <button class="topic" onclick="chooseTopic(this,'Friends')">💬 Friends<small>Friendly conversations</small></button>
    <button class="topic" onclick="chooseTopic(this,'Education')">🎓 Education<small>College and studies</small></button>
    <button class="topic" onclick="chooseTopic(this,'Business')">📈 Business<small>Professional English</small></button>
  </div>

  <input id="customTopic" placeholder="Or enter your own topic...">

  <h3 class="section-title" style="margin-top:22px">Conversation level</h3>
  <select id="level">
    <option value="Beginner">Beginner</option>
    <option value="Intermediate">Intermediate</option>
    <option value="Advanced">Advanced</option>
  </select>

  <button class="primary" onclick="startCall()">Start AI Call　➜</button>
  <p class="note">Practice speaking English naturally, one conversation at a time.</p>
  <div class="footer">CALLMATE AI · SPEAK WITH CONFIDENCE</div>
</section>

<!-- INCOMING CALL PAGE -->
<section id="incoming" class="page call-page">
  <div class="topbar" style="width:100%">
    <button class="back" onclick="showPage('home')">‹ Back</button>
    <strong>CallMate <span>AI</span></strong>
    <span>●</span>
  </div>

  <div class="avatar">
    <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5">
      <circle cx="12" cy="8" r="4"/>
      <path d="M4 21c0-5 3-8 8-8s8 3 8 8"/>
    </svg>
  </div>
  <div class="caller">CallMate AI</div>
  <div class="topic-label" id="incomingTopic">Daily Conversation</div>
  <div class="call-status">Incoming voice call...</div>

  <div class="incoming-actions">
    <button class="call-action" onclick="declineCall()">
      <span class="round red">✕</span>Decline
    </button>
    <button class="call-action" onclick="answerCall()">
      <span class="round green">☎</span>Answer
    </button>
  </div>
</section>

<!-- ACTIVE CALL PAGE -->
<section id="call" class="page call-page">
  <div class="topbar" style="width:100%">
    <span>● Connected</span>
    <strong>CallMate <span>AI</span></strong>
    <span>HD Voice</span>
  </div>

  <div class="avatar connected">
    <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5">
      <circle cx="12" cy="8" r="4"/>
      <path d="M4 21c0-5 3-8 8-8s8 3 8 8"/>
    </svg>
  </div>
  <div class="caller">CallMate AI</div>
  <div class="topic-label" id="activeTopic">Daily Conversation</div>
  <div class="call-status" id="status">Connected · Speak now</div>
  <div class="timer" id="timer">00:00</div>

  <div class="message" id="transcript">Hello! How are you today? Let's practice English together.</div>

  <div class="keypad" id="keypad">
    <button onclick="addKey('1')">1</button><button onclick="addKey('2')">2</button><button onclick="addKey('3')">3</button>
    <button onclick="addKey('4')">4</button><button onclick="addKey('5')">5</button><button onclick="addKey('6')">6</button>
    <button onclick="addKey('7')">7</button><button onclick="addKey('8')">8</button><button onclick="addKey('9')">9</button>
    <button onclick="addKey('*')">*</button><button onclick="addKey('0')">0</button><button onclick="addKey('#')">#</button>
  </div>

  <div class="controls">
    <button class="control" id="muteBtn" onclick="toggleMute()"><span class="round">🎙</span>Mute</button>
    <button class="control" id="keyBtn" onclick="toggleKeypad()"><span class="round">▦</span>Keypad</button>
    <button class="control" id="speakerBtn" onclick="toggleSpeaker()"><span class="round">🔊</span>Speaker</button>
    <button class="control" id="holdBtn" onclick="toggleHold()"><span class="round">Ⅱ</span>Hold</button>
    <button class="control" onclick="repeatReply()"><span class="round">↻</span>Repeat</button>
    <button class="control" onclick="startListening()"><span class="round">🎤</span>Speak</button>
  </div>

  <button class="end-button call-action" onclick="endCall()">
    <span class="round red">☎</span>End call
  </button>
</section>

<!-- CALL ENDED PAGE -->
<section id="ended" class="page call-page">
  <div class="end-icon">☎</div>
  <div class="caller">Call Ended</div>
  <p class="summary">Your English practice session is complete.</p>
  <div class="duration" id="finalDuration">00:00</div>
  <p class="summary">Call duration</p>
  <button class="primary" onclick="resetApp()">Practice Again</button>
  <button class="secondary" onclick="showPage('home')">Back to Home</button>
  <div class="footer">KEEP PRACTICING. KEEP IMPROVING.</div>
</section>

</div>

<script>
/* CALLMATE AI SETTINGS */

// Optional: Add your secure backend URL here.
// Never put a private AI API key in this HTML file.
const AI_ENDPOINT = "";

let selectedTopic = "Daily Conversation";
let callStart = 0;
let timerInterval = null;
let elapsed = 0;
let recognition = null;
let isMuted = false;
let isHeld = false;
let speakerOn = true;
let lastReply = "";
let lastUserText = "";
let conversationMode = "Beginner";
let callActive = false;

function showPage(page){
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
  document.getElementById(page).classList.add("active");
}

function chooseTopic(button,topic){
  document.querySelectorAll(".topic").forEach(b=>b.classList.remove("selected"));
  button.classList.add("selected");
  selectedTopic = topic;
}

function startCall(){
  const custom = document.getElementById("customTopic").value.trim();
  if(custom) selectedTopic = custom;
  conversationMode = document.getElementById("level").value;
  document.getElementById("incomingTopic").textContent = selectedTopic;
  showPage("incoming");
}

function declineCall(){
  showPage("home");
}

function answerCall(){
  callActive = true;
  elapsed = 0;
  callStart = Date.now();
  document.getElementById("activeTopic").textContent = selectedTopic;
  document.getElementById("timer").textContent = "00:00";
  document.getElementById("status").textContent = "Connected · Speak now";
  document.getElementById("transcript").textContent = "Hello! Welcome to CallMate AI. Let's talk about " + selectedTopic + ". How are you today?";
  showPage("call");
  timerInterval = setInterval(updateTimer,1000);
  speak("Hello! Welcome to CallMate AI. Let's talk about " + selectedTopic + ". How are you today?");
}

function updateTimer(){
  if(!callActive || isHeld) return;
  elapsed = Math.floor((Date.now()-callStart)/1000);
  document.getElementById("timer").textContent = formatTime(elapsed);
}

function formatTime(seconds){
  const m = Math.floor(seconds/60).toString().padStart(2,"0");
  const s = (seconds%60).toString().padStart(2,"0");
  return m+":"+s;
}

function speak(text){
  if(!speakerOn || isHeld) return;
  if(!("speechSynthesis" in window)) return;
  speechSynthesis.cancel();
  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = "en-US";
  utterance.rate = conversationMode==="Beginner" ? 0.88 : 1;
  utterance.pitch = 1;
  utterance.onstart = ()=> {
    document.getElementById("status").textContent = "CallMate AI is speaking...";
  };
  utterance.onend = ()=> {
    if(callActive && !isHeld){
      document.getElementById("status").textContent = "Connected · Your turn to speak";
    }
  };
  speechSynthesis.speak(utterance);
}

function startListening(){
  if(!callActive || isHeld || isMuted) return;

  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SpeechRecognition){
    document.getElementById("status").textContent = "Voice recognition is not supported. Try Chrome on Android.";
    return;
  }

  try{
    if(recognition) recognition.abort();
    recognition = new SpeechRecognition();
    recognition.lang = "en-US";
    recognition.interimResults = false;
    recognition.continuous = false;

    recognition.onstart = ()=>{
      document.getElementById("status").textContent = "Listening... Speak now";
    };

    recognition.onresult = async (event)=>{
      const text = event.results[0][0].transcript;
      lastUserText = text;
      document.getElementById("transcript").textContent = "You: " + text;
      await getAIReply(text);
    };

    recognition.onerror = (event)=>{
      document.getElementById("status").textContent = "Voice error: " + event.error + ". Tap Speak to try again.";
    };

    recognition.onend = ()=>{
      if(callActive && !isHeld && !isMuted){
        // Tap Speak again when you are ready to continue.
      }
    };

    recognition.start();
  }catch(e){
    document.getElementById("status").textContent = "Please try speaking again.";
  }
}

async function getAIReply(userText){
  document.getElementById("status").textContent = "Thinking...";

  // Use a secure backend if configured.
  if(AI_ENDPOINT){
    try{
      const response = await fetch(AI_ENDPOINT,{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({
          message:userText,
          topic:selectedTopic,
          level:conversationMode
        })
      });
      if(!response.ok) throw new Error("AI service unavailable");
      const data = await response.json();
      const reply = data.reply || data.response;
      if(reply){
        lastReply = reply;
        document.getElementById("transcript").textContent = "AI: " + reply;
        speak(reply);
        return;
      }
    }catch(error){
      console.error(error);
    }
  }

  // Built-in practice conversation when no AI backend is configured.
  const reply = localReply(userText);
  lastReply = reply;
  document.getElementById("transcript").textContent = "AI: " + reply;
  speak(reply);
}

function localReply(text){
  const msg = text.toLowerCase();

  if(msg.includes("hello") || msg.includes("hi")){
    return "Hello! It's lovely to talk with you. Can you tell me a little about yourself?";
  }
  if(msg.includes("name")){
    return "That's nice! What do you enjoy doing in your free time?";
  }
  if(msg.includes("college") || msg.includes("study") || msg.includes("student")){
    return "That sounds interesting! Which subject do you enjoy the most, and why?";
  }
  if(msg.includes("job") || msg.includes("interview") || msg.includes("work")){
    return "Good answer! What are your biggest strengths? Try explaining with a simple example.";
  }
  if(msg.includes("thank")){
    return "You're welcome! You're doing well. Let's continue. What are your goals for the future?";
  }
  if(msg.includes("don't know") || msg.includes("not sure")){
    return "That's okay! Take your time. You can start with a short sentence. What do you think about " + selectedTopic + "?";
  }
  if(msg.includes("bye")){
    return "It was wonderful talking with you. Keep practising your English. Have a great day!";
  }

  if(conversationMode==="Beginner"){
    return "Good try! Your sentence is understandable. Can you tell me a little more about that? Try using two or three simple sentences.";
  }
  if(conversationMode==="Intermediate"){
    return "That's an interesting point. Could you explain why you feel that way? Try adding an example to support your answer.";
  }
  return "Interesting perspective. Can you elaborate on your reasoning and share a real-life example?";
}

function repeatReply(){
  if(lastReply) speak(lastReply);
  else speak("Hello! Let's practise English together.");
}

function toggleMute(){
  isMuted = !isMuted;
  document.getElementById("muteBtn").classList.toggle("active",isMuted);
  document.getElementById("muteBtn").lastChild.textContent = isMuted ? "Unmute" : "Mute";
  if(isMuted && recognition) recognition.stop();
  document.getElementById("status").textContent = isMuted ? "Microphone muted" : "Microphone on";
}

function toggleHold(){
  isHeld = !isHeld;
  document.getElementById("holdBtn").classList.toggle("active",isHeld);
  document.getElementById("holdBtn").lastChild.textContent = isHeld ? "Resume" : "Hold";

  if(isHeld){
    if(recognition) recognition.stop();
    speechSynthesis.cancel();
    document.getElementById("status").textContent = "Call on hold";
  }else{
    document.getElementById("status").textContent = "Call resumed · Tap Speak";
  }
}

function toggleSpeaker(){
  speakerOn = !speakerOn;
  document.getElementById("speakerBtn").classList.toggle("active",speakerOn);
  document.getElementById("speakerBtn").lastChild.textContent = speakerOn ? "Speaker" : "Speaker off";
  if(!speakerOn) speechSynthesis.cancel();
}

function toggleKeypad(){
  const keypad = document.getElementById("keypad");
  keypad.style.display = keypad.style.display==="grid" ? "none" : "grid";
  document.getElementById("keyBtn").classList.toggle("active");
}

function addKey(key){
  document.getElementById("status").textContent = "Key pressed: " + key;
}

function endCall(){
  callActive = false;
  if(timerInterval) clearInterval(timerInterval);
  if(recognition) recognition.stop();
  if("speechSynthesis" in window) speechSynthesis.cancel();

  elapsed = Math.floor((Date.now()-callStart)/1000);
  document.getElementById("finalDuration").textContent = formatTime(elapsed);
  showPage("ended");
}

function resetApp(){
  callActive = false;
  if(timerInterval) clearInterval(timerInterval);
  if(recognition) recognition.stop();
  if("speechSynthesis" in window) speechSynthesis.cancel();

  isMuted = false;
  isHeld = false;
  speakerOn = true;
  lastReply = "";
  lastUserText = "";
  document.getElementById("customTopic").value = "";
  document.getElementById("keypad").style.display = "none";
  document.querySelectorAll(".control").forEach(b=>b.classList.remove("active"));
  showPage("home");
}

/* Create a basic manifest dynamically.
   Full offline PWA support requires a separate service worker file. */
const manifestData = {
  name:"CallMate AI",
  short_name:"CallMate",
  start_url:".",
  display:"standalone",
  background_color:"#090817",
  theme_color:"#090817",
  description:"AI English speaking practice app"
};
const manifestBlob = new Blob([JSON.stringify(manifestData)],{type:"application/manifest+json"});
document.getElementById("manifest").href = URL.createObjectURL(manifestBlob);

</script>
</body>
</html>
